# Токен бота, полученный от @BotFather в Telegram
BOT_TOKEN=123456789:AAExampleTokenReplaceMe

# Telegram user_id администраторов через запятую (узнать свой ID можно у @userinfobot)
ADMIN_IDS=123456789

# Контакт для кнопки "Связаться с водителем": username (@username) или номер телефона (+998901234567)
ADMIN_CONTACT=@driver_username

# Необязательно: путь к файлу базы данных SQLite
DB_PATH=evacuator.db
